<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Edit Deployment Service</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #0f172a;
            font-family: Arial, sans-serif;
            color: white;

            display: flex;
            justify-content: center;
            align-items: center;

            height: 100vh;
        }

        .edit-box {

            width: 450px;

            background: #1e293b;

            padding: 40px;

            border-radius: 18px;

            box-shadow: 0 0 25px rgba(0,0,0,0.4);
        }

        .title {

            text-align: center;

            margin-bottom: 30px;
        }

        .title h1 {

            color: #38bdf8;

            font-size: 32px;

            margin-bottom: 10px;
        }

        .title p {

            color: #cbd5e1;
        }

        label {

            display: block;

            margin-bottom: 10px;

            color: #94a3b8;

            font-size: 15px;
        }

        input[type="text"] {

            width: 100%;

            padding: 15px;

            border: none;

            border-radius: 10px;

            margin-bottom: 25px;

            background: #334155;

            color: white;

            font-size: 16px;
        }

        input[type="text"]:focus {

            outline: 2px solid #38bdf8;
        }

        .btn {

            width: 100%;

            padding: 15px;

            border: none;

            border-radius: 10px;

            background: #38bdf8;

            color: black;

            font-size: 16px;

            font-weight: bold;

            cursor: pointer;

            transition: 0.3s;
        }

        .btn:hover {

            background: #0ea5e9;
        }

        .back-btn {

            margin-top: 20px;

            display: block;

            text-align: center;

            text-decoration: none;

            color: #94a3b8;
        }

        .service-name {

            background: #334155;

            padding: 12px;

            border-radius: 10px;

            margin-bottom: 20px;

            color: #38bdf8;

            text-align: center;

            font-weight: bold;
        }

    </style>

</head>

<body>

    <div class="edit-box">

        <div class="title">

            <h1>
                🚀 Edit Deployment Service
            </h1>

            <p>
                Update your AWS DevOps service
            </p>

        </div>

        <div class="service-name">

            Current Service:
            <%- todo %>

        </div>

        <form action="/dashboard/edit/<%= todoIdx %>"
              method="POST">

            <input type="hidden"
                   name="_method"
                   value="PUT">

            <label for="editTodo">

                Update Service Name

            </label>

            <input type="text"
                   name="editTodo"
                   id="editTodo"
                   placeholder="Enter updated service name"
                   autofocus />

            <button class="btn"
                    type="submit">

                Save Changes

            </button>

        </form>

        <a class="back-btn"
           href="/dashboard">

            ← Back to Dashboard

        </a>

    </div>

</body>

</html>